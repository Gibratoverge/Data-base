        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    AIRPORT {\n        int airport_id PK\n        varchar airport_name\n        varchar country\n        varchar state\n        varchar city\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    AIRLINE {\n        int airline_id PK\n        varchar airline_code UK\n        varchar name\n        varchar country\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    FLIGHT {\n        int flight_id PK\n        varchar departing_gate\n        varchar arriving_gate\n        timestamp scheduled_departure_time\n        timestamp scheduled_arrival_time\n        timestamp actual_departure_time\n        timestamp actual_arrival_time\n        timestamp created_at\n        timestamp updated_at\n        int airline_id FK\n        int departure_airport_id FK\n        int arrival_airport_id FK\n    }\n\n    PASSENGER {\n        int passenger_id PK\n        varchar first_name\n        varchar last_name\n        varchar gender\n        date date_of_birth\n        varchar country_of_citizenship\n        varchar country_of_residence\n        varchar passport_number UK\n        timestamp profile_created_at\n        timestamp profile_updated_at\n    }\n\n    BOOKING {\n        int booking_id PK\n        int flight_id FK\n        int passenger_id FK\n        varchar status\n        varchar booking_platform\n        decimal ticket_price\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    BOOKING_CHANGE {\n        int booking_change_id PK\n        int booking_id FK\n        varchar change_description\n        timestamp changed_at\n    }\n\n    BOARDING_PASS {\n        int boarding_pass_id PK\n        int booking_id FK UK\n        varchar seat\n        timestamp boarding_time\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    BAGGAGE {\n        int baggage_id PK\n        int booking_id FK\n        decimal weight_kg\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    BAGGAGE_CHECK {\n        int baggage_check_id PK\n        int booking_id FK\n        int passenger_id FK\n        varchar check_result\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    SECURITY_CHECK {\n        int security_check_id PK\n        int passenger_id FK\n        varchar check_result\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    AIRLINE ||--o{ FLIGHT : operates\n    AIRPORT ||--o{ FLIGHT : departure_airport\n    AIRPORT ||--o{ FLIGHT : arrival_airport\n    FLIGHT ||--o{ BOOKING : has\n    PASSENGER ||--o{ BOOKING : makes\n    BOOKING ||--o{ BOOKING_CHANGE : records\n    BOOKING ||--o| BOARDING_PASS : issues\n    BOOKING ||--o{ BAGGAGE : includes\n    BAGGAGE ||--o{ BAGGAGE_CHECK : undergoes\n    PASSENGER ||--o{ BAGGAGE_CHECK : associated_with\n    PASSENGER ||--o{ SECURITY_CHECK : undergoes&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="K_tqW758R41umBGWcxAS-130">
